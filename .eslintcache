n  visitedNodesInOrder = [];\r\n  \r\n\r\n   \r\n  \r\n    var state =  dfs(maze,node);\r\n    console.log('state: ' + state)\r\n    if(state){\r\n        return visitedNodesInOrder;\r\n    }else if (!state){\r\n        if(visitedNodesInOrder === 0){\r\n            return 'start position is completly blocked'\r\n        }\r\n        return visitedNodesInOrder\r\n    }\r\n    \r\n}\r\nfunction dfs(maze, node){\r\n    \r\n    if (maze[node.row][node.col].isFinish){\r\n       console.log(\"FOUND IT AT: ROW: \" + node.row + \" COL: \" + node.col );\r\n        return true;\r\n    }\r\n\r\n    var neighbours = getNeighbors(maze,node);\r\n    //typeof(neighbors) === 'undefined' ||\r\n    if (neighbours.length <= 0){\r\n        return false;\r\n    }\r\n    for (var i=0;i<neighbours.length;i++){\r\n        console.log('Visited: ' + \"(\" + node.row + \",\" + node.col + \")\");\r\n        \r\n        maze[neighbours[i].row][neighbours[i].col].isVisited = true;\r\n        console.log()\r\n        if(dfs(maze,neighbours[i])){\r\n            return true;\r\n        }\r\n    }\r\n    return false;\r\n}\r\n//directions\r\nconst dr = [-1,+1,0,0];\r\nconst dc = [0,0,+1,-1];\r\n\r\nfunction getNeighbors(grid,node){\r\n  var neighbours = [];\r\n    //checks all direction from the node added\r\n    for (let i = 0; i < 4; i++) {\r\n        var   newRow = node.row + dr[i];\r\n        var   newCol = node.col + dc[i];\r\n        \r\n           //if the column or row is outside the grid then we stop iterating\r\n           if(newCol < 0 || newCol >= grid[0].length|| newRow < 0 || newRow >= grid.length){\r\n                 continue;\r\n             }\r\n\r\n             \r\n             //checking that the node has not already been visited else we stop iterating\r\n             if (grid[newRow][newCol].isVisited){\r\n                 continue;\r\n             }\r\n\r\n             if(grid[newRow][newCol].isWall){\r\n                 continue;\r\n             }\r\n             //push valid neighbours from current node\r\n             visitedNodesInOrder.push({row: node.row,col: node.col})\r\n             neighbours.push({row: newRow,col: newCol})\r\n  }\r\nreturn neighbours;\r\n}\r\n\r\n\r\n\r\n","C:\\Users\\Ali\\Desktop\\Pathfinding algorithm\\my-pathfinding\\src\\visualize\\algorithms\\pathfindingAlgorithms\\Bfs.js",[],{"ruleId":"50","replacedBy":"51"},{"ruleId":"52","replacedBy":"53"},{"ruleId":"54","severity":1,"message":"55","line":16,"column":5,"nodeType":"56","messageId":"57","endLine":16,"endColumn":12},{"ruleId":"54","severity":1,"message":"58","line":17,"column":5,"nodeType":"56","messageId":"57","endLine":17,"endColumn":13},{"ruleId":"54","severity":1,"message":"59","line":18,"column":5,"nodeType":"56","messageId":"57","endLine":18,"endColumn":18},{"ruleId":"60","severity":1,"message":"61","line":550,"column":15,"nodeType":"62","messageId":"63","endLine":565,"endColumn":2},{"ruleId":"54","severity":1,"message":"64","line":3,"column":5,"nodeType":"56","messageId":"57","endLine":3,"endColumn":12},{"ruleId":"65","severity":1,"message":"66","line":39,"column":33,"nodeType":"67","messageId":"68","endLine":39,"endColumn":34},{"ruleId":"54","severity":1,"message":"64","line":3,"column":5,"nodeType":"56","messageId":"57","endLine":3,"endColumn":12},{"ruleId":"65","severity":1,"message":"66","line":39,"column":33,"nodeType":"67","messageId":"68","endLine":39,"endColumn":34},"no-native-reassign",["69"],"no-negated-in-lhs",["70"],"no-unused-vars","'wallBtn' is assigned a value but never used.","Identifier","unusedVar","'eraseBtn' is assigned a value but never used.","'mouseHeldDown' is defined but never used.","no-loop-func","Function declared in a loop contains unsafe references to variable(s) 'circle', 'previousCircle', 'previousCircle', 'previousCircle', 'previousCircle', 'circle', 'circle', 'circle', 'circle'.","ArrowFunctionExpression","unsafeRefs","'visited' is assigned a value but never used.","no-useless-concat","Unexpected string concatenatio